# ============================================================
# 环境变量模板
# 使用方法：复制本文件为 .env，然后把所有占位符替换为真实值
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# 注意：.env 已被 .gitignore 排除，请勿提交真实密码与密钥
# ============================================================

# DeepSeek API 配置
# 获取密钥：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Flask 配置
FLASK_SECRET_KEY=your-secret-key-here

# 数据库配置（所有后端脚本统一从这里读取，见 utils/db_config.py）
# 如果不修改主机/端口/库名，只需设置 DB_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=medicalinfo
DB_CHARSET=utf8mb4
DB_PASSWORD=your-db-password-here
